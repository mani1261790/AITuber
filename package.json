{
  "name": "aituber",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --filter './packages/**' build && pnpm --parallel --filter @aituber/server --filter @aituber/classroom --filter @aituber/operator dev",
    "start": "node --env-file-if-exists=.env --experimental-strip-types scripts/start-self-host.ts",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "configure:tts": "zsh scripts/configure-fish-audio.zsh",
    "configure:llm": "zsh scripts/configure-llm.zsh",
    "build:provider-tools": "pnpm --filter @aituber/providers --filter @aituber/storage build",
    "verify:llm": "pnpm build:provider-tools && node --env-file-if-exists=.env --experimental-strip-types scripts/verify-llm.ts",
    "verify:tts": "pnpm build:provider-tools && node --env-file-if-exists=.env --experimental-strip-types scripts/verify-fish-audio.ts",
    "measure:tts": "pnpm build:provider-tools && node --env-file-if-exists=.env --experimental-strip-types scripts/measure-fish-audio.ts",
    "acceptance:mvp": "vitest run apps/server/src/mvp-acceptance.test.ts --reporter=verbose",
    "backup": "node --env-file-if-exists=.env --experimental-strip-types scripts/backup-self-host.ts",
    "restore": "node --env-file-if-exists=.env --experimental-strip-types scripts/restore-self-host.ts",
    "verify:self-host": "node --experimental-strip-types scripts/verify-self-host.ts",
    "study:new": "node --env-file-if-exists=.env --experimental-strip-types scripts/usability-study.ts new",
    "study:status": "node --env-file-if-exists=.env --experimental-strip-types scripts/usability-study.ts status",
    "study:summarize": "node --env-file-if-exists=.env --experimental-strip-types scripts/usability-study.ts summarize",
    "study:delete": "node --env-file-if-exists=.env --experimental-strip-types scripts/usability-study.ts delete",
    "study:delete-raw": "node --env-file-if-exists=.env --experimental-strip-types scripts/usability-study.ts delete-raw",
    "verify:client-boundaries": "node --env-file-if-exists=.env --experimental-strip-types scripts/verify-client-boundaries.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:client-boundaries && pnpm verify:self-host"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
