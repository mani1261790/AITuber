# LLM: one OpenAI-compatible connection
AITUBER_LLM_API_KEY=
AITUBER_LLM_MODEL=
AITUBER_LLM_BASE_URL=
AITUBER_LLM_INPUT_USD_PER_MILLION_TOKENS=
AITUBER_LLM_OUTPUT_USD_PER_MILLION_TOKENS=
AITUBER_AUTHORING_DAILY_BUDGET_USD=
AITUBER_RUNTIME_DAILY_BUDGET_USD=
AITUBER_AUTHORING_DAILY_LLM_TOKEN_LIMIT=100000000
AITUBER_RUNTIME_DAILY_LLM_TOKEN_LIMIT=10000000

# Speech: one Fish Audio connection
AITUBER_FISH_AUDIO_API_KEY=
AITUBER_FISH_AUDIO_MODEL=s2.1-pro-free
AITUBER_FISH_AUDIO_VOICE_ID=b2d9d8db057042688a5e318b8f405bc2
# s2.1-pro-free is treated as 0. Set this when using another Fish model.
AITUBER_TTS_USD_PER_MILLION_CHARACTERS=
AITUBER_RUNTIME_DAILY_TTS_CHARACTER_LIMIT=1000000

# Local server. Default stays on this computer. Set a private address such as
# 192.168.1.20 only when learners on the same LAN should join.
AITUBER_LAN_HOST=127.0.0.1
AITUBER_PORT=4310
AITUBER_CLASSROOM_PORT=4311
AITUBER_OPERATOR_PORT=4312
AITUBER_DATA_DIR=.data
# Individual paths can override AITUBER_DATA_DIR when needed.
# AITUBER_DB_PATH=/absolute/path/aituber.db
# AITUBER_LLM_SETTINGS_PATH=/absolute/path/llm-settings.json
# AITUBER_AUTHORING_PATH=/absolute/path/authoring
# AITUBER_TTS_CACHE_PATH=/absolute/path/tts-cache
# AITUBER_BACKUP_PATH=/absolute/path/backups
AITUBER_FIXED_PLAYBACK_MS=2000
# Local Irodori trial: start pnpm tts:irodori first, then set provider=irodori.
# Caption/reference/steps changes require a new voice revision to invalidate audio cache.
AITUBER_TTS_PROVIDER=fish
AITUBER_IRODORI_ENDPOINT=http://127.0.0.1:4313/v1/audio/speech
AITUBER_IRODORI_VOICE_REVISION=teacher-v1

# Optional dedicated blackboard SVG model. No key means no SVG tool calls.
AITUBER_SVG_API_KEY=
AITUBER_SVG_MODEL=arrow-2

# Local SVG trial. none disables it; quiver requires explicit selection and a paid key.
AITUBER_SVG_PROVIDER=none
AITUBER_OMNISVG_ENDPOINT=http://127.0.0.1:4314/v1/svg
# Optional external-disk directory for runtime and both model downloads:
# AITUBER_OMNISVG_HOME=/Volumes/YourDisk/aituber-omnisvg
