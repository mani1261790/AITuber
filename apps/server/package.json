{
  "name": "@aituber/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aituber/content": "workspace:*",
    "@aituber/contracts": "workspace:*",
    "@aituber/lesson": "workspace:*",
    "@aituber/providers": "workspace:*",
    "@aituber/storage": "workspace:*",
    "pdfjs-dist": "6.1.200",
    "unpdf": "1.8.1",
    "ws": "8.21.3",
    "@aituber/runtime-platform": "workspace:*"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
