{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@aituber/contracts": ["./packages/contracts/src/index.ts"],
      "@aituber/content": ["./packages/content/src/index.ts"],
      "@aituber/lesson": ["./packages/lesson/src/index.ts"],
      "@aituber/presentation": ["./packages/presentation/src/index.ts"],
      "@aituber/providers": ["./packages/providers/src/index.ts"],
      "@aituber/storage": ["./packages/storage/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
